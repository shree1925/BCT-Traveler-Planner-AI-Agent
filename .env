# ---- LLM providers: at least ONE is required -------------------------------
# Gemini AND Gemma both use this one key. Free: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Nemotron via NVIDIA NIM. Free: https://build.nvidia.com  (key starts with nvapi-)
NVIDIA_API_KEY=

# Nemotron via the Hugging Face router. Free: https://huggingface.co/settings/tokens
HF_TOKEN=

# ---- Email delivery (optional) ---------------------------------------------
# Use a Google APP PASSWORD, not your account password.
# https://myaccount.google.com/apppasswords  (needs 2-Step Verification on)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
